<!-- Pie Chart Sensor 0 -->
<div class="col-12 col-md-6 col-lg-5 col-xl-4">
    <div class="card shadow mb-4">
        <!-- Card Header - Dropdown -->
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary" id="sensor0">Sensor 0</h6>
            <div class="dropdown no-arrow">
                <a class="dropdown-toggle" href="#" role="button" id="dropdownMenuLink0"
                   data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="fas fa-ellipsis-v fa-sm fa-fw text-gray-400"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-right shadow animated--fade-in"
                     aria-labelledby="dropdownMenuLink0">
                    <div class="dropdown-header">Action:</div>
                    <a class="dropdown-item" id="configsensor0" onclick="LoadSensorSettings()" data-backdrop="static" data-keyboard="false" data-toggle="modal" data-target="#sensorSettingsModal">Config Sensor</a>
                    <a class="dropdown-item" href="#">View sensor data</a>
                </div>
            </div>
        </div>
        <!-- Card Body -->
        <div class="card-body">
            <div class="chart-pie pt-4 pb-2">
                <canvas id="sensor0PieChart"></canvas>
            </div>
            <div class="mt-4 text-center small">
                <span class="mr-2">
                    <i class="fas fa-tint" style="color: #52b788"></i> Moisture: <span id="sensor0MoistValue">--</span>
                </span>
                <span class="mr-2">
                    <i class="fas fa-sun" style="color: #e9c46a"></i> Dry: <span id="sensor0DryValue">--</span>
                </span>
            </div>
        </div>
    </div>
</div>

