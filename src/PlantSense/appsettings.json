  "AllowedHosts": "*",
  "ZWave": {
    "MqttHost": "localhost",
    "MqttPort": 1883,
    "DiscoveryTopicFilters": [ "zwave/+/nodeinfo", "zwave/+/+/nodeinfo" ]
  },
  "Zigbee": {
    "MqttHost": "localhost",
    "MqttPort": 1883,
    "BaseTopic": "zigbee2mqtt"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "Override": {
      "Microsoft.AspNetCore": "Warning"
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  }
}